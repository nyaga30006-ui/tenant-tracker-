{
  "name": "myproperty-functions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "migration:import:emulator": "npm run build && node lib/migration/importV2BundleToEmulator.js",
    "migration:preview-auth": "node scripts/create-migration-preview-auth.mjs",
    "migration:transform": "npm run build && node lib/migration/transformV1ExportCli.js",
    "test": "npm run build && node --test lib/monthlyReset.test.js lib/migration/importV2BundleToEmulator.test.js lib/migration/v1Transform.test.js",
    "test:migration:emulator": "npm run build && node --test lib/migration/importV2BundleToEmulator.integration.test.js",
    "test:emulator": "npm run build && npm run test:emulator:built",
    "test:emulator:built": "node --test --test-concurrency=1 lib/monthlyReset.integration.test.js lib/tenantResidency.integration.test.js lib/userAccounts.integration.test.js",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
