{
  "name": "myproperty-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:firebase": "vite --mode firebase-emulator",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:emulators": "node scripts/firebase-cli.mjs emulators:start --project demo-myproperty --only auth,firestore,functions,pubsub",
    "firebase:seed": "npm --prefix functions run seed:emulator",
    "firebase:deploy:staging:auth": "node scripts/firebase-cli.mjs deploy --project myproperty-v2-staging --only auth",
    "firebase:deploy:staging:rules": "node scripts/firebase-cli.mjs deploy --project myproperty-v2-staging --only firestore:rules,firestore:indexes",
    "firebase:deploy:staging:functions": "node scripts/firebase-cli.mjs deploy --project myproperty-v2-staging --only functions",
    "firebase:deploy:staging:hosting": "npm run build:staging && node scripts/firebase-cli.mjs deploy --project myproperty-v2-staging --only hosting",
    "firebase:test": "npm --prefix functions run build && node scripts/firebase-cli.mjs emulators:exec --project demo-myproperty --only auth,firestore,functions \"npm run firebase:test:inside\"",
    "firebase:test:migration": "node scripts/firebase-cli.mjs emulators:exec --config firebase.migration-test.json --project demo-migration --only firestore \"npm --prefix functions run test:migration:emulator\"",
    "firebase:test:inside": "npm run firebase:test:rules && npm --prefix functions run test:emulator:built",
    "firebase:test:rules": "vitest run --config vitest.firebase.config.ts"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.33.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.11"
  }
}
